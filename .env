# Deployment runtime configuration
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://your-frontend-domain.com

# Security (generated)
JWT_SECRET=4657ba7e82b6f77a36f634ecbce22da6f2a016b9cbf916a306770b7d10b61ebee014b10d898b720dee93f1e839f38a30
