PG_SSL=true

# Email (SMTP/Brevo)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=replace_with_brevo_smtp_user
EMAIL_PASS=replace_with_brevo_smtp_password
