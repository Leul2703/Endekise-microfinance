# Copy to .env and fill values
JWT_SECRET=change_this_to_a_secure_secret
FRONTEND_URL=http://localhost:5173

# SMTP / Email settings
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_smtp_username_or_email
EMAIL_PASS=your_smtp_password_or_app_password
EMAIL_FROM="Edekise Microfinance <noreply@edekise.com>"

# Optional test recipient (used by scripts/test-email.js)
TEST_EMAIL_TO=your_email@example.com
