# Backend environment template (deployment)
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://your-frontend-domain.com

# Security
JWT_SECRET=replace_with_strong_64_char_secret
ENCRYPTION_KEY=replace_with_32_byte_encryption_key

# Database (PostgreSQL)
DB_CLIENT=postgres
DATABASE_URL=postgresql://db_user:db_password@db_host:5432/edekise_microfinance
DB_HOST=db_host
DB_PORT=5432
DB_NAME=edekise_microfinance
DB_USER=db_user
DB_PASSWORD=db_password
PG_SSL=true

# Email (SMTP/Brevo)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_brevo_smtp_user
EMAIL_PASS=your_brevo_smtp_password
EMAIL_FROM="Edekise Microfinance <noreply@yourdomain.com>"
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@yourdomain.com
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Edekise Microfinance

# File upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Loan policy controls
LOAN_LATE_PENALTY_RATE=1
LOAN_RATE_MICRO_ENTERPRISE=8
LOAN_RATE_INDIVIDUAL_BUSINESS=7.5
LOAN_RATE_CONSUMPTION=9
LOAN_RATE_CONSTRUCTION=12
LOAN_RATE_AGRICULTURAL_BUSINESS=10

# Seed users (disable in production)
SEED_DEFAULT_USERS=false
